# Gemini API (free tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemma-4-31b-it
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Supabase PostgreSQL (direct connection)
# Find this in Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase project details (for fetching system settings)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# CORS origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-domain.com

# App settings
EMBEDDING_DIMENSION=768
RAG_TOP_K=10
RAG_SCORE_THRESHOLD=0.35
RAG_MAX_CHUNKS=5
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=10
