## Database Schema Additions

New tables needed (added to existing Supabase PostgreSQL):

```sql
-- Enable pgvector extension
CREATE EXTENSION IF NOT EXISTS vector;

-- 1. Chat sessions & messages (replaces ad-hoc storage)
CREATE TABLE chat_sessions (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE,
    session_type TEXT DEFAULT 'reactive', -- reactive | proactive
    initiation_type TEXT, -- user_message | nudge_article | nudge_calc | nudge_return
    started_at TIMESTAMPTZ DEFAULT NOW(),
    ended_at TIMESTAMPTZ,
    message_count INT DEFAULT 0,
    metadata JSONB DEFAULT '{}'
);

CREATE TABLE chat_messages (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    session_id UUID REFERENCES chat_sessions(id) ON DELETE CASCADE,
    role TEXT NOT NULL, -- user | assistant | system
    content TEXT NOT NULL,
    tokens_used INT,
    model_used TEXT,
    rag_chunks_used UUID[],
    compliance_flags JSONB DEFAULT '{}',
    feedback TEXT, -- like | dislike | null
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- 2. User personas (persistent, versioned)
CREATE TABLE user_personas (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE UNIQUE,
    version INT DEFAULT 1,
    data JSONB NOT NULL DEFAULT '{}',
    -- data includes: goals[], risk_profile, literacy_level, life_stage,
    -- income_bracket, investment_experience, preferred_products[]
    confidence_scores JSONB DEFAULT '{}',
    last_enriched_at TIMESTAMPTZ,
    consent_version TEXT,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- 3. Vector chunks for RAG
CREATE TABLE document_chunks (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    doc_id UUID NOT NULL,
    namespace TEXT NOT NULL, -- regulations | concepts | news | tax | products
    content TEXT NOT NULL,
    content_hash TEXT UNIQUE NOT NULL,
    embedding vector(1536),
    metadata JSONB DEFAULT '{}',
    -- metadata: {source_url, source_date, author, doc_title, chunk_index}
    source_date TIMESTAMPTZ,
    ttl_days INT, -- NULL = no expiry (regs), 90 = news
    superseded_by UUID REFERENCES document_chunks(id),
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- HNSW index for fast vector search
CREATE INDEX ON document_chunks 
    USING hnsw (embedding vector_cosine_ops) 
    WITH (m = 16, ef_construction = 128);

-- 4. Source documents registry
CREATE TABLE source_documents (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    url TEXT UNIQUE,
    title TEXT,
    namespace TEXT NOT NULL,
    doc_hash TEXT, -- detect changes on re-crawl
    last_crawled_at TIMESTAMPTZ,
    chunk_count INT DEFAULT 0,
    trust_level INT DEFAULT 3, -- 1-5 (5 = internal, 1 = user-generated)
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- 5. Nudge log
CREATE TABLE nudge_log (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE,
    nudge_type TEXT NOT NULL, -- article_goal | calc_use | return_visit | deadline
    score FLOAT NOT NULL,
    opener_text TEXT,
    shown_at TIMESTAMPTZ DEFAULT NOW(),
    dismissed BOOLEAN DEFAULT FALSE,
    engaged BOOLEAN DEFAULT FALSE,
    session_id UUID REFERENCES chat_sessions(id),
    metadata JSONB DEFAULT '{}'
);

-- 6. Session signals (browsing context)
CREATE TABLE session_signals (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE,
    signal_type TEXT NOT NULL, -- page_view | scroll_depth | calc_use | search
    payload JSONB NOT NULL,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- Index for 48h window queries
CREATE INDEX idx_session_signals_user_time 
    ON session_signals(user_id, created_at DESC);

-- 7. Consent log (DPDPA compliance)
CREATE TABLE consent_log (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE,
    data_category TEXT NOT NULL, -- browsing | financial | personal | behavioral
    consent_given BOOLEAN NOT NULL,
    purpose TEXT,
    version TEXT,
    granted_at TIMESTAMPTZ DEFAULT NOW(),
    withdrawn_at TIMESTAMPTZ
);

-- 8. Compliance audit log
CREATE TABLE compliance_audit (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    session_id UUID REFERENCES chat_sessions(id),
    check_type TEXT NOT NULL, -- sebi | hallucination | dpdpa | escalation
    result TEXT NOT NULL, -- pass | block | warn | escalate
    details JSONB DEFAULT '{}',
    created_at TIMESTAMPTZ DEFAULT NOW()
);
```

