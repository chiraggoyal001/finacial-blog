# Copy this file to .env and fill in your Supabase credentials
# IMPORTANT: The old API key was exposed in Git history.
# You MUST rotate your Supabase key in the dashboard before using this app in production.
#
# Steps to rotate your key:
# 1. Go to https://app.supabase.com/project/_/settings/api
# 2. Click "Reveal" next to Project API keys
# 3. Click "Generate a new JWT secret" (this invalidates all old keys)
# 4. Copy the new anon/public key below

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-new-anon-key-here
